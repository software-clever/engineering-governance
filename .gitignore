# The banned-token list read by scripts/neutrality-check.mjs. Never committed:
# a tracked list would publish the identifiers it exists to keep out. The
# tracked template is neutrality.tokens.example. CI writes this file from a
# repository secret.
neutrality.tokens

# Gate parameters and rule records belong to the adopting business (layer 3),
# not to this engine. If one of these appears here, it is in the wrong repo.
*.instance.json
/instance/

node_modules/
dist/
coverage/

# OS and editor cruft
Thumbs.db
.DS_Store
*.swp
